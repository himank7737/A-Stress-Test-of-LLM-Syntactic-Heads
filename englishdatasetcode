import os
import string
import torch
import numpy as np
from conllu import parse
from tqdm import tqdm
from google.colab import files
from transformers import GPT2LMHeadModel, GPT2Tokenizer

# ==========================================
# 1. Setup & Initialization
# ==========================================
print(" Loading model and tokenizer...")
device = "cuda" if torch.cuda.is_available() else "cpu"
tokenizer = GPT2Tokenizer.from_pretrained("gpt2")
model = GPT2LMHeadModel.from_pretrained("gpt2").to(device)
model.eval()
print(f" Model loaded on {device.upper()}.")

# ==========================================
# 2. Core Logic Functions
# ==========================================
def analyze_sentence(text):
    """
    Scans a sentence for a major surprisal spike (garden path).
    If a spike is found, applies linguistic filters to weed out false positives.
    Returns: (is_valid_candidate, spike_index)
    """
    # Encode text and get model predictions
    input_ids = tokenizer.encode(text, return_tensors="pt").to(device)
    
    with torch.no_grad():
        outputs = model(input_ids, labels=input_ids)
        log_probs = torch.nn.functional.log_softmax(outputs.logits[..., :-1, :], dim=-1)
        token_log_probs = torch.gather(log_probs, 2, input_ids[..., 1:].unsqueeze(-1)).squeeze(-1)
        surprisals = [0.0] + (-token_log_probs / np.log(2)).cpu().numpy().tolist()[0]

    # Look for a spike > 3.5 Z-score
    for i in range(3, len(surprisals)):
        history = surprisals[:i]
        z_score = (surprisals[i] - np.mean(history)) / (np.std(history) + 0.1)
        
        if z_score > 3.5:
            # We found a mathematical spike! Now let's test if it makes linguistic sense.
            spike_token_id = input_ids[0, i].item()
            spike_token = tokenizer.decode([spike_token_id]).strip()

            # --- FILTER 1: Punctuation & Symbols ---
            if all(char in string.punctuation for char in spike_token):
                return False, None

            # --- FILTER 2: Numbers ---
            if any(char.isdigit() for char in spike_token):
                return False, None

            # --- FILTER 3: Rare Proper Nouns ---
            # If it starts with a capital letter (and isn't the first word)
            if spike_token and spike_token[0].isupper() and i > 0:
                return False, None

            # It survived all filters—this is a true garden path candidate!
            return True, i
            
    return False, None

# ==========================================
# 3. Main Execution Block
# ==========================================
input_file = "en_ewt-ud-train.conllu" # Update path if needed, e.g., "/content/en_ewt-ud-train.conllu"
output_file = "final_true_garden_paths.conllu"

if os.path.exists(input_file):
    # Load the CoNLL-U data
    with open(input_file, "r", encoding="utf-8") as f:
        data = parse(f.read())

    final_sentences = []
    total_raw_spikes = 0

    print(f" Scanning {len(data)} sentences")

    # Process each sentence
    for sentence in tqdm(data):
        text = sentence.metadata['text']
        
        # Skip very short sentences
        if len(text.split()) < 6: 
            continue

        is_valid_garden_path, spike_idx = analyze_sentence(text)

        if is_valid_garden_path:
            # Tag the metadata so you know exactly where the trap was triggered
            sentence.metadata['disambiguation_index'] = str(spike_idx)
            final_sentences.append(sentence)

    # Save the filtered results
    with open(output_file, "w", encoding="utf-8") as f:
        for sent in final_sentences:
            f.write(sent.serialize())

    print(f"\n  Saved {len(final_sentences)} HIGH-QUALITY sentences to '{output_file}'.")
    
    # Trigger download
    files.download(output_file)
else:
    print(f"'{input_file}' not found")
